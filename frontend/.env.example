# Modo de datos:
#   VITE_MOCK=0  → llama al backend FastAPI por /api (proxy de Vite a http://localhost:8000). Default.
#   VITE_MOCK=1  → la UI corre sola con data/*.json (sin backend), con badge "Mock" en la barra.
# También se puede cambiar en caliente con ?modo=mock o ?modo=backend en la URL (vale para esa pestaña).
VITE_MOCK=0

# Base del backend. Dejar /api para usar el proxy de Vite (evita CORS).
VITE_API_URL=/api

# Solo modo mock: multiplica las demoras simuladas (0.25 = 4 veces más rápido, útil para desarrollar).
VITE_MOCK_SPEED=1
